# Copy to .env and fill in. NEVER commit .env.

# Vast.ai API key (server-side only; never sent to the browser)
VASTAI_API=your_vastai_api_key_here

# Dashboard login token — required for any public bind.
# generate:  openssl rand -hex 24
VAST_DASH_TOKEN=change_me_to_a_long_random_string

# Bind address on the host. 127.0.0.1 = local only (use an SSH tunnel or
# a reverse proxy for remote access). 0.0.0.0 = all interfaces (token required).
DASH_BIND=127.0.0.1
DASH_PORT=8090

# container-side (leave as is)
VAST_DASH_HOST=0.0.0.0
VAST_DASH_PORT=8090

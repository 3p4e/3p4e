# BIG DOGMA outreach (no secrets here; the password lives in .smtp_pass, chmod 600)
SENDER_NAME=
FROM=inf.unit@bigdogma.tech
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
# Emails go out only Mon-Fri inside these hours (Skopje time), 70-160 s apart
SEND_HOURS=9-16
TZ=Europe/Skopje
PAUSE_MIN=70
PAUSE_MAX=160
# yes = attach the offer PDF to the first email (default no: the PDF button is on each private page, and attachments hurt cold-email delivery)
ATTACH_PDF=no
